---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Sidebar from '../components/Sidebar.astro'
import SearchBar from '../components/SearchBar.astro'
import SiteCard from '../components/SiteCard.astro'
import sites from '../data/sites.json'

// 定义分类顺序和图标
const categories = [
  { id: '大模型官网', name: '大模型官网', icon: '🌐' },
  { id: 'API 提供商', name: 'API 提供商', icon: '🔌' },
  { id: '聚合平台', name: '聚合平台', icon: '🔀' },
  { id: 'AI 客户端', name: 'AI 客户端', icon: '💻' },
  { id: '开源社区', name: '开源社区', icon: '👥' },
  { id: '其他', name: '其他', icon: '📦' },
]

// 按分类分组网站
const sitesByCategory = categories.reduce((acc, cat) => {
  acc[cat.id] = sites.filter(s => s.category === cat.id)
  return acc
}, {} as Record<string, typeof sites>)

const categoryCounts = {
  all: sites.length,
  ...categories.reduce((acc, cat) => {
    acc[cat.id] = sitesByCategory[cat.id].length
    return acc
  }, {} as Record<string, number>)
}
---

<Layout title="AI Dashboard - AI 网站导航">
  <Header siteCount={sites.length}>
    <SearchBar slot="search" value="" />
  </Header>
  
  <Sidebar activeCategory="all" categories={categories} />
  
  <main class="lg:ml-64 min-h-screen">
    <div class="p-4 lg:p-6 space-y-10">
      {categories.map((category) => (
        sitesByCategory[category.id].length > 0 && (
          <section id={`category-${category.id}`} class="category-section">
            <div class="flex items-center gap-3 mb-4">
              <h2 class="text-xl font-bold text-[var(--color-text)] flex items-center gap-2">
                <span>{category.icon}</span>
                <span>{category.name}</span>
              </h2>
              <span class="text-sm text-[var(--color-text-secondary)] bg-[var(--color-surface)] px-2 py-0.5 rounded-full">
                {sitesByCategory[category.id].length}
              </span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
              {sitesByCategory[category.id].map((site) => (
                <div 
                  data-category={site.category} 
                  data-name={site.name} 
                  data-models={site.models.join(',')} 
                  data-description={site.description.toLowerCase()}
                  class="site-item"
                >
                  <SiteCard site={site} />
                </div>
              ))}
            </div>
          </section>
        )
      ))}
    </div>
    
    <div id="no-results" class="hidden text-center py-16">
      <p class="text-[var(--color-text-secondary)] text-lg">没有找到匹配的网站</p>
    </div>
  </main>
</Layout>

<script define:vars={{ categoryCounts }}>
  const searchInput = document.getElementById('search-input')
  const sidebarItems = document.querySelectorAll('.sidebar-item')
  const noResults = document.getElementById('no-results')
  const siteItems = document.querySelectorAll('.site-item')
  const headerSiteCount = document.getElementById('header-site-count')
  
  let currentSearch = ''
  
  function filterSites() {
    let visibleCount = 0
    const sections = document.querySelectorAll('.category-section')
    
    siteItems.forEach(item => {
      const name = item.dataset.name.toLowerCase()
      const models = item.dataset.models.toLowerCase()
      const description = item.dataset.description
      
      const searchMatch = currentSearch === '' || 
        name.includes(currentSearch) || 
        models.includes(currentSearch) ||
        description.includes(currentSearch)
      
      if (searchMatch) {
        item.classList.remove('hidden')
        item.classList.add('block')
        visibleCount++
      } else {
        item.classList.add('hidden')
        item.classList.remove('block')
      }
    })
    
    // 隐藏空 section
    sections.forEach(section => {
      const visibleItems = section.querySelectorAll('.site-item:not(.hidden)')
      if (visibleItems.length === 0) {
        section.classList.add('hidden')
      } else {
        section.classList.remove('hidden')
      }
    })
    
    if (headerSiteCount) {
      headerSiteCount.textContent = visibleCount
    }
    
    noResults.classList.toggle('hidden', visibleCount > 0)
  }
  
  // 侧边栏点击滚动
  sidebarItems.forEach(item => {
    item.addEventListener('click', () => {
      const category = item.dataset.category
      
      // 更新激活状态
      sidebarItems.forEach(i => {
        i.classList.remove('bg-[var(--color-accent)]', 'text-white')
        i.classList.add('text-[var(--color-text)]', 'hover:bg-[var(--color-surface)]')
      })
      
      item.classList.add('bg-[var(--color-accent)]', 'text-white')
      item.classList.remove('text-[var(--color-text)]', 'hover:bg-[var(--color-surface)]')
      
      // 滚动到对应 section
      if (category !== 'all') {
        const targetSection = document.getElementById(`category-${category}`)
        if (targetSection) {
          const headerOffset = 80
          const elementPosition = targetSection.getBoundingClientRect().top
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset
          
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          })
        }
      } else {
        // "全部" 滚动到顶部
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        })
      }
    })
  })
  
  // 搜索
  searchInput?.addEventListener('input', (e) => {
    currentSearch = e.target.value.toLowerCase().trim()
    filterSites()
  })
  
  // 键盘快捷键：Ctrl+K (Windows/Linux) 或 Cmd+K (Mac) 聚焦搜索框
  document.addEventListener('keydown', (e) => {
    // 检测是否为快捷键组合 (Ctrl+K 或 Cmd+K)
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault()
      searchInput?.focus()
      // 选中已有文本
      searchInput?.select()
    }
  })
</script>
