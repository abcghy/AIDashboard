---
interface Site {
  id: string
  name: string
  url: string
  description: string
  category: string
  models: string[]
}

interface Props {
  site: Site
}

const { site } = Astro.props
---

<a
  href={site.url}
  target="_blank"
  rel="noopener noreferrer"
  class="site-card block p-5 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-xl hover:bg-[var(--color-card-hover)] hover:border-[var(--color-border)] hover:shadow-md transition-all duration-200"
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex-1 min-w-0">
      <h3 class="font-semibold text-lg text-[var(--color-text)]">
        {site.name}
      </h3>
      <p class="text-sm text-[var(--color-text-secondary)] mt-1.5 line-clamp-2">
        {site.description}
      </p>
      {site.models.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {site.models.slice(0, 4).map((model) => (
            <span class="model-tag px-2 py-0.5 text-xs bg-[var(--color-surface)] text-[var(--color-text-secondary)] rounded-md border border-[var(--color-border)]">
              {model}
            </span>
          ))}
          {site.models.length > 4 && (
            <span class="px-2 py-0.5 text-xs text-[var(--color-text-secondary)]">
              +{site.models.length - 4}
            </span>
          )}
        </div>
      )}
    </div>
    <div class="flex-shrink-0 p-2 rounded-lg bg-[var(--color-surface)]">
      <svg 
        class="w-5 h-5 text-[var(--color-text-secondary)]" 
        fill="none" 
        stroke="currentColor" 
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </div>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
