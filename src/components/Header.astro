---
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  siteCount: number
}

const { siteCount } = Astro.props
---

<header class="sticky top-0 z-40 w-full bg-[var(--color-background)]/80 backdrop-blur-md border-b border-[var(--color-border)]">
  <div class="flex items-center justify-between h-16 px-4 lg:px-6">
    <!-- Logo -->
    <div class="flex items-center gap-3 flex-shrink-0">
      <div class="w-8 h-8 rounded-lg bg-[var(--color-accent)] flex items-center justify-center">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
      </div>
      <span class="font-bold text-lg text-[var(--color-text)] hidden sm:block">AI Dashboard</span>
    </div>

    <!-- Search -->
    <div class="flex-1 max-w-md mx-4">
      <slot name="search" />
    </div>

    <!-- Right side -->
    <div class="flex items-center gap-4 flex-shrink-0">
      <div class="hidden sm:flex items-center gap-2 text-sm text-[var(--color-text-secondary)]">
        <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
        <span id="header-site-count">{siteCount}</span>
        <span>个网站</span>
      </div>
      <ThemeToggle />
    </div>
  </div>
</header>
